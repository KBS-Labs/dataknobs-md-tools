#!/bin/bash

# DataKnobs Font Management Tool
# Universal wrapper for managing fonts in native and Docker modes

set -e

# Get the directory where this script is located
SCRIPT_PATH="${BASH_SOURCE[0]}"
# Resolve symlinks to get the actual script location
while [ -L "$SCRIPT_PATH" ]; do
    SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
    SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
    # Handle relative symlinks
    [[ "$SCRIPT_PATH" != /* ]] && SCRIPT_PATH="$SCRIPT_DIR/$SCRIPT_PATH"
done
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Auto-activate virtual environment if it exists
if [ -f "$PROJECT_ROOT/.venv/bin/activate" ]; then
    source "$PROJECT_ROOT/.venv/bin/activate"
fi

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

print_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

print_error() {
    echo -e "${RED}[ERROR]${NC} $1" >&2
}

print_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

# Check if Docker is available
check_docker() {
    if command -v docker >/dev/null 2>&1; then
        if docker info >/dev/null 2>&1; then
            return 0
        fi
    fi
    return 1
}

# Display usage information
usage() {
    cat << 'EOF'
DataKnobs Font Management Tool

Manage fonts for PDF/HTML generation in both native and Docker modes.

Usage: dk-fonts [OPTIONS] COMMAND [ARGS]

COMMANDS:
    list [OPTIONS]              List available fonts
        --category CATEGORY     Filter by category (serif, sans-serif, monospace)
        --search QUERY          Search for fonts containing text
        --detailed              Show detailed font information
        --limit N               Limit results to N fonts

    search QUERY                Search for fonts by name

    validate FONT_NAME          Check if a font is available
        --no-suggest            Don't suggest alternatives

    categories                  List available font categories

    install [OPTIONS]           Install fonts (native mode only)
        liberation              Install Liberation fonts
        noto                    Install Noto fonts
        dejavu                  Install DejaVu fonts
        source-code-pro         Install Source Code Pro
        roboto                  Install Roboto
        all                     Install recommended font set
        custom FILE             Install a custom font file

    info                        Show font system information

EXAMPLES:
    dk-fonts list                              # List all fonts
    dk-fonts list --category monospace         # List monospace fonts
    dk-fonts list --search "Arial"             # Search for Arial fonts
    dk-fonts search "Liberation"               # Search for Liberation fonts
    dk-fonts validate "Arial"                  # Check if Arial is available
    dk-fonts install liberation                # Install Liberation fonts
    dk-fonts install all                       # Install recommended fonts
    dk-fonts categories                        # Show font categories

DOCKER MODE:
    In Docker mode, font listing works automatically. For custom fonts,
    mount your fonts directory:

    docker run -v ~/my-fonts:/usr/local/share/fonts/custom \\
               -v $(pwd):/workspace dataknobs/md-tools \\
               dk-fonts list

EOF
}

# Detect if running in Docker
is_docker() {
    [ -f /.dockerenv ] || grep -q docker /proc/1/cgroup 2>/dev/null
}

# Install fonts (native mode only)
install_fonts() {
    if is_docker; then
        print_error "Font installation not available in Docker mode"
        echo "To use custom fonts in Docker, mount them as a volume:"
        echo "  docker run -v ~/my-fonts:/usr/local/share/fonts/custom ..."
        exit 1
    fi

    FONT_SET="$1"

    case "$FONT_SET" in
        liberation)
            if [[ "$OSTYPE" == "darwin"* ]]; then
                print_info "Installing Liberation fonts on macOS..."
                brew tap homebrew/cask-fonts 2>/dev/null || true
                brew install --cask font-liberation 2>/dev/null || brew install font-liberation-sans
            elif command -v apt-get >/dev/null 2>&1; then
                print_info "Installing Liberation fonts on Debian/Ubuntu..."
                sudo apt-get update && sudo apt-get install -y fonts-liberation fonts-liberation2
            elif command -v dnf >/dev/null 2>&1; then
                print_info "Installing Liberation fonts on Fedora/RHEL..."
                sudo dnf install -y liberation-fonts
            elif command -v pacman >/dev/null 2>&1; then
                print_info "Installing Liberation fonts on Arch Linux..."
                sudo pacman -S --noconfirm ttf-liberation
            else
                print_error "Unsupported package manager"
                exit 1
            fi
            ;;

        noto)
            if [[ "$OSTYPE" == "darwin"* ]]; then
                print_info "Installing Noto fonts on macOS..."
                brew tap homebrew/cask-fonts 2>/dev/null || true
                brew install --cask font-noto-sans font-noto-serif font-noto-mono
            elif command -v apt-get >/dev/null 2>&1; then
                print_info "Installing Noto fonts on Debian/Ubuntu..."
                sudo apt-get update && sudo apt-get install -y fonts-noto fonts-noto-cjk fonts-noto-mono
            elif command -v dnf >/dev/null 2>&1; then
                print_info "Installing Noto fonts on Fedora/RHEL..."
                sudo dnf install -y google-noto-fonts google-noto-fonts-common google-noto-cjk-fonts
            elif command -v pacman >/dev/null 2>&1; then
                print_info "Installing Noto fonts on Arch Linux..."
                sudo pacman -S --noconfirm noto-fonts noto-fonts-cjk
            else
                print_error "Unsupported package manager"
                exit 1
            fi
            ;;

        dejavu)
            if [[ "$OSTYPE" == "darwin"* ]]; then
                print_info "Installing DejaVu fonts on macOS..."
                brew tap homebrew/cask-fonts 2>/dev/null || true
                brew install --cask font-dejavu
            elif command -v apt-get >/dev/null 2>&1; then
                print_info "Installing DejaVu fonts on Debian/Ubuntu..."
                sudo apt-get update && sudo apt-get install -y fonts-dejavu fonts-dejavu-core fonts-dejavu-extra
            elif command -v dnf >/dev/null 2>&1; then
                print_info "Installing DejaVu fonts on Fedora/RHEL..."
                sudo dnf install -y dejavu-fonts-common dejavu-sans-fonts dejavu-serif-fonts dejavu-sans-mono-fonts
            elif command -v pacman >/dev/null 2>&1; then
                print_info "Installing DejaVu fonts on Arch Linux..."
                sudo pacman -S --noconfirm ttf-dejavu
            else
                print_error "Unsupported package manager"
                exit 1
            fi
            ;;

        source-code-pro)
            if [[ "$OSTYPE" == "darwin"* ]]; then
                print_info "Installing Source Code Pro on macOS..."
                brew tap homebrew/cask-fonts 2>/dev/null || true
                brew install --cask font-source-code-pro
            elif command -v apt-get >/dev/null 2>&1; then
                print_info "Installing Source Code Pro on Debian/Ubuntu..."
                sudo apt-get update && sudo apt-get install -y fonts-source-code-pro
            elif command -v dnf >/dev/null 2>&1; then
                print_info "Installing Source Code Pro on Fedora/RHEL..."
                sudo dnf install -y adobe-source-code-pro-fonts
            elif command -v pacman >/dev/null 2>&1; then
                print_info "Installing Source Code Pro on Arch Linux..."
                sudo pacman -S --noconfirm adobe-source-code-pro-fonts
            else
                print_error "Unsupported package manager"
                exit 1
            fi
            ;;

        roboto)
            if [[ "$OSTYPE" == "darwin"* ]]; then
                print_info "Installing Roboto on macOS..."
                brew tap homebrew/cask-fonts 2>/dev/null || true
                brew install --cask font-roboto
            elif command -v apt-get >/dev/null 2>&1; then
                print_info "Installing Roboto on Debian/Ubuntu..."
                sudo apt-get update && sudo apt-get install -y fonts-roboto fonts-roboto-unhinted
            elif command -v dnf >/dev/null 2>&1; then
                print_info "Installing Roboto on Fedora/RHEL..."
                sudo dnf install -y google-roboto-fonts
            elif command -v pacman >/dev/null 2>&1; then
                print_info "Installing Roboto on Arch Linux..."
                sudo pacman -S --noconfirm ttf-roboto
            else
                print_error "Unsupported package manager"
                exit 1
            fi
            ;;

        all)
            print_info "Installing recommended font set..."
            install_fonts liberation
            install_fonts noto
            install_fonts dejavu
            install_fonts source-code-pro
            install_fonts roboto
            ;;

        custom)
            FONT_FILE="$2"
            if [ -z "$FONT_FILE" ]; then
                print_error "Please specify a font file"
                exit 1
            fi

            if [ ! -f "$FONT_FILE" ]; then
                print_error "Font file not found: $FONT_FILE"
                exit 1
            fi

            if [[ "$OSTYPE" == "darwin"* ]]; then
                FONT_DIR="$HOME/Library/Fonts"
            else
                FONT_DIR="$HOME/.local/share/fonts"
                mkdir -p "$FONT_DIR"
            fi

            print_info "Installing font: $(basename "$FONT_FILE")"
            cp "$FONT_FILE" "$FONT_DIR/"

            # Refresh font cache on Linux
            if [[ "$OSTYPE" != "darwin"* ]]; then
                fc-cache -f -v >/dev/null 2>&1 || true
            fi
            ;;

        *)
            print_error "Unknown font set: $FONT_SET"
            echo "Available: liberation, noto, dejavu, source-code-pro, roboto, all, custom"
            exit 1
            ;;
    esac

    # Refresh font cache
    if command -v fc-cache >/dev/null 2>&1; then
        print_info "Refreshing font cache..."
        fc-cache -f -v >/dev/null 2>&1 || true
    fi

    print_info "Font installation complete!"
}

# Show font system information
show_info() {
    echo -e "${BLUE}Font System Information${NC}"
    echo "======================="
    echo

    if is_docker; then
        echo "Environment: Docker"
    else
        echo "Environment: Native"
    fi

    echo "OS: $OSTYPE"

    if command -v fc-list >/dev/null 2>&1; then
        FONT_COUNT=$(fc-list : family | wc -l)
        echo "Fontconfig: Available"
        echo "Total fonts: $FONT_COUNT"
    else
        echo "Fontconfig: Not available"
    fi

    echo

    # Show font directories
    echo "Font directories:"
    if [[ "$OSTYPE" == "darwin"* ]]; then
        echo "  System: /Library/Fonts"
        echo "  System: /System/Library/Fonts"
        echo "  User:   $HOME/Library/Fonts"
    else
        echo "  System: /usr/share/fonts"
        echo "  System: /usr/local/share/fonts"
        echo "  User:   $HOME/.local/share/fonts"
        if [ -d /usr/local/share/fonts/custom ]; then
            echo "  Custom: /usr/local/share/fonts/custom (Docker mount)"
        fi
    fi

    echo

    # Show recommended fonts availability
    echo "Recommended fonts:"
    for font in "Liberation Sans" "Liberation Mono" "Noto Sans" "Noto Serif" "DejaVu Sans" "Source Code Pro" "Roboto"; do
        if command -v uv >/dev/null 2>&1; then
            if (cd "$PROJECT_ROOT" && uv run python3 -m python.font_manager validate "$font" --no-suggest >/dev/null 2>&1); then
                echo -e "  ${GREEN}✓${NC} $font"
            else
                echo -e "  ${RED}✗${NC} $font"
            fi
        fi
    done
}

# Parse command line arguments
COMMAND=""
ARGS=()

for arg in "$@"; do
    case $arg in
        -h|--help)
            usage
            exit 0
            ;;
        *)
            if [ -z "$COMMAND" ]; then
                COMMAND="$arg"
            else
                ARGS+=("$arg")
            fi
            ;;
    esac
done

# Execute command
case "$COMMAND" in
    list|search|validate|categories)
        # Use Python font manager for these commands
        if command -v uv >/dev/null 2>&1; then
            cd "$PROJECT_ROOT"
            exec uv run python3 -m python.font_manager "$COMMAND" "${ARGS[@]}"
        else
            exec python3 -m python.font_manager "$COMMAND" "${ARGS[@]}"
        fi
        ;;

    install)
        if [ ${#ARGS[@]} -eq 0 ]; then
            print_error "Please specify what to install"
            echo "Examples: liberation, noto, dejavu, source-code-pro, roboto, all"
            exit 1
        fi
        install_fonts "${ARGS[@]}"
        ;;

    info)
        show_info
        ;;

    "")
        print_error "No command specified"
        usage
        exit 1
        ;;

    *)
        print_error "Unknown command: $COMMAND"
        usage
        exit 1
        ;;
esac
