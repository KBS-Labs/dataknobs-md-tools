#!/bin/bash

# DataKnobs Markdown Tools - Batch Converter
# Converts multiple Markdown files to PDF or HTML with various options

set -e

# Get the directory where this script is located
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Default values
OUTPUT_FORMAT="pdf"
OUTPUT_DIR=""
PRESERVE_STRUCTURE=false
FLATTEN=false
PARALLEL_JOBS=1
DRY_RUN=false
VERBOSE=false
OVERWRITE=false
RECURSIVE=false
QUIET=false
INCLUDE_PATTERN=""
EXCLUDE_PATTERN=""
CONVERTER_ARGS=()
SHOW_PROGRESS=true

# Counters for summary
TOTAL_FILES=0
PROCESSED_FILES=0
SKIPPED_FILES=0
FAILED_FILES=0
FAILED_LIST=()

print_info() {
    [ "$QUIET" = false ] && echo -e "${GREEN}[INFO]${NC} $1"
}

print_error() {
    echo -e "${RED}[ERROR]${NC} $1" >&2
}

print_warning() {
    [ "$QUIET" = false ] && echo -e "${YELLOW}[WARNING]${NC} $1"
}

print_progress() {
    [ "$QUIET" = false ] && [ "$SHOW_PROGRESS" = true ] && echo -e "${CYAN}[PROGRESS]${NC} $1"
}

print_debug() {
    [ "$VERBOSE" = true ] && echo -e "${BLUE}[DEBUG]${NC} $1" >&2 || true
}

# Display usage information
usage() {
    cat << EOF
DataKnobs Markdown Batch Converter

Converts multiple Markdown files to PDF or HTML with support for glob patterns,
directory recursion, parallel processing, and flexible output options.

Usage: $(basename "$0") [OPTIONS] [FILES/PATTERNS...]

INPUT PATTERNS:
    *.md                    All .md files in current directory
    **/*.md                 All .md files recursively (requires -r/--recursive)
    docs/*.md               All .md files in docs directory
    file1.md file2.md       Specific files
    docs/                   All .md files in directory (with -r)

OPTIONS:
    -h, --help              Show this help message
    -f, --format FORMAT     Output format: pdf (default) or html
    -o, --output-dir DIR    Output directory (default: same as input)
    -p, --preserve-structure Preserve directory structure in output
    --flatten               Flatten all outputs to single directory
    -j, --jobs N            Number of parallel jobs (default: 1, max: CPU cores)
    -r, --recursive         Process directories recursively
    -n, --dry-run           Show what would be done without doing it
    -v, --verbose           Enable verbose output
    -q, --quiet             Suppress non-error output
    --overwrite             Force overwrite existing files
    --no-progress           Disable progress indicators

    FILTERING:
    --include PATTERN       Include only files matching pattern (regex)
    --exclude PATTERN       Exclude files matching pattern (regex)

    CONVERTER OPTIONS:
    -t, --theme THEME       CSS theme to use (github, academic, minimal)
    --toc                   Include table of contents
    --no-mermaid           Skip Mermaid diagram processing
    --standalone           Create standalone HTML (embeds CSS)
    --keep-html            When generating PDF, also save HTML
    --keep-svgs            Keep SVG files as external files

EXAMPLES:
    # Convert all .md files in current directory to PDF
    $(basename "$0") *.md

    # Convert all .md files recursively to HTML in ./output
    $(basename "$0") -r -f html -o ./output .

    # Preserve directory structure with parallel processing
    $(basename "$0") -r -p -j 4 -o ./build docs/

    # Dry run with verbose output
    $(basename "$0") -n -v -r docs/**/*.md

    # Convert with theme and TOC
    $(basename "$0") -t academic --toc -o pdfs/ *.md

    # Filter files by pattern
    $(basename "$0") -r --include "README" --exclude "draft" docs/

NOTES:
    - Progress is shown by default unless -q/--quiet is used
    - Use -j auto to automatically use all CPU cores
    - Patterns are matched using bash globbing (*, ?, **)
    - Recursive mode (-r) is required for ** patterns
    - Exit codes: 0 = success, 1 = some failures, 2 = all failed

EOF
}

# Parse command line arguments
parse_args() {
    while [[ $# -gt 0 ]]; do
        case $1 in
            -h|--help)
                usage
                exit 0
                ;;
            -f|--format)
                OUTPUT_FORMAT="$2"
                if [[ ! "$OUTPUT_FORMAT" =~ ^(pdf|html)$ ]]; then
                    print_error "Invalid format: $OUTPUT_FORMAT (must be pdf or html)"
                    exit 1
                fi
                shift 2
                ;;
            -o|--output-dir)
                OUTPUT_DIR="$2"
                shift 2
                ;;
            -p|--preserve-structure)
                PRESERVE_STRUCTURE=true
                shift
                ;;
            --flatten)
                FLATTEN=true
                shift
                ;;
            -j|--jobs)
                if [ "$2" = "auto" ]; then
                    PARALLEL_JOBS=$(nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 1)
                else
                    PARALLEL_JOBS="$2"
                fi
                shift 2
                ;;
            -r|--recursive)
                RECURSIVE=true
                shift
                ;;
            -n|--dry-run)
                DRY_RUN=true
                shift
                ;;
            -v|--verbose)
                VERBOSE=true
                CONVERTER_ARGS+=("-v")
                shift
                ;;
            -q|--quiet)
                QUIET=true
                SHOW_PROGRESS=false
                shift
                ;;
            --overwrite)
                OVERWRITE=true
                CONVERTER_ARGS+=("--overwrite")
                shift
                ;;
            --no-progress)
                SHOW_PROGRESS=false
                shift
                ;;
            --include)
                INCLUDE_PATTERN="$2"
                shift 2
                ;;
            --exclude)
                EXCLUDE_PATTERN="$2"
                shift 2
                ;;
            # Converter-specific options
            -t|--theme)
                CONVERTER_ARGS+=("-t" "$2")
                shift 2
                ;;
            --toc)
                CONVERTER_ARGS+=("--toc")
                shift
                ;;
            --no-mermaid)
                CONVERTER_ARGS+=("--no-mermaid")
                shift
                ;;
            --standalone)
                CONVERTER_ARGS+=("--standalone")
                shift
                ;;
            --keep-html)
                CONVERTER_ARGS+=("--keep-html")
                shift
                ;;
            --keep-svgs)
                CONVERTER_ARGS+=("--keep-svgs")
                shift
                ;;
            --show-filename)
                CONVERTER_ARGS+=("--show-filename")
                shift
                ;;
            -*)
                print_error "Unknown option: $1"
                usage
                exit 1
                ;;
            *)
                # Input file/pattern
                INPUT_PATTERNS+=("$1")
                shift
                ;;
        esac
    done
}

# Find all markdown files based on patterns
find_markdown_files() {
    local -a files
    local -a patterns
    files=()
    patterns=("$@")

    print_debug "Function called with ${#@} arguments: $@"

    if [ ${#patterns[@]} -eq 0 ]; then
        # No patterns specified, use current directory
        patterns=(".")
    fi

    for pattern in "${patterns[@]}"; do
        print_debug "Processing pattern: $pattern"

        if [ -f "$pattern" ]; then
            # Single file
            if [[ "$pattern" == *.md ]]; then
                files+=("$pattern")
                print_debug "Added file: $pattern"
            else
                print_warning "Skipping non-markdown file: $pattern"
            fi
        elif [ -d "$pattern" ]; then
            # Directory
            print_debug "Processing directory: $pattern"
            if [ "$RECURSIVE" = true ]; then
                while IFS= read -r -d '' file; do
                    files+=("$file")
                    print_debug "Added from directory (recursive): $file"
                done < <(find "$pattern" -type f -name "*.md" -print0)
            else
                for file in "$pattern"/*.md; do
                    if [ -f "$file" ]; then
                        files+=("$file")
                        print_debug "Added from directory: $file"
                    fi
                done
            fi
        else
            # Glob pattern or non-existent file
            if [[ "$pattern" == *"**"* ]] && [ "$RECURSIVE" = false ]; then
                print_error "Pattern '$pattern' requires -r/--recursive flag"
                exit 1
            fi

            # Enable globstar for ** patterns
            if [[ "$pattern" == *"**"* ]]; then
                shopt -s globstar
            fi
            shopt -s nullglob

            # Expand the glob pattern
            local matches=( $pattern )

            # If no matches, check if it's a literal filename that doesn't exist yet
            if [ ${#matches[@]} -eq 0 ]; then
                print_debug "No matches for pattern: $pattern"
            else
                for file in "${matches[@]}"; do
                    if [ -f "$file" ] && [[ "$file" == *.md ]]; then
                        files+=("$file")
                        print_debug "Added file from pattern: $file"
                    fi
                done
            fi

            shopt -u nullglob
            if [[ "$pattern" == *"**"* ]]; then
                shopt -u globstar
            fi
        fi
    done

    # Apply include/exclude filters
    local filtered_files=()
    for file in "${files[@]}"; do
        local include=true

        # Check include pattern
        if [ -n "$INCLUDE_PATTERN" ]; then
            if ! echo "$file" | grep -qE "$INCLUDE_PATTERN"; then
                include=false
                print_debug "Excluding $file (doesn't match include pattern)"
            fi
        fi

        # Check exclude pattern
        if [ -n "$EXCLUDE_PATTERN" ] && [ "$include" = true ]; then
            if echo "$file" | grep -qE "$EXCLUDE_PATTERN"; then
                include=false
                print_debug "Excluding $file (matches exclude pattern)"
            fi
        fi

        if [ "$include" = true ]; then
            filtered_files+=("$file")
            print_debug "File passed filters: $file"
        fi
    done

    # Remove duplicates and sort
    print_debug "Total files before dedup: ${#filtered_files[@]}"
    if [ ${#filtered_files[@]} -gt 0 ]; then
        print_debug "Outputting files: ${filtered_files[@]}"
        printf '%s\n' "${filtered_files[@]}" | sort -u
    else
        print_debug "No files to output"
    fi
}

# Calculate output path for a file
get_output_path() {
    local input_file="$1"
    local output_file

    # Get the base name without .md extension
    local base_name=$(basename "${input_file%.md}")

    if [ -n "$OUTPUT_DIR" ]; then
        if [ "$PRESERVE_STRUCTURE" = true ] && [ "$FLATTEN" = false ]; then
            # Preserve directory structure
            local rel_path="${input_file#./}"  # Remove leading ./
            # Handle case where file is in current dir (dirname returns ".")
            local dir_path=$(dirname "$rel_path")
            if [ "$dir_path" = "." ]; then
                output_file="$OUTPUT_DIR/${base_name}.${OUTPUT_FORMAT}"
            else
                output_file="$OUTPUT_DIR/$dir_path/${base_name}.${OUTPUT_FORMAT}"
            fi
        else
            # Flatten structure or no structure preservation
            output_file="$OUTPUT_DIR/${base_name}.${OUTPUT_FORMAT}"
        fi
    else
        # Output in same directory as input
        local dir_path=$(dirname "$input_file")
        output_file="$dir_path/${base_name}.${OUTPUT_FORMAT}"
    fi

    echo "$output_file"
}

# Convert a single file
convert_file() {
    local input_file="$1"
    local output_file="$2"

    # Create output directory if needed
    local output_dir=$(dirname "$output_file")
    if [ ! -d "$output_dir" ]; then
        if [ "$DRY_RUN" = false ]; then
            mkdir -p "$output_dir"
        else
            print_debug "Would create directory: $output_dir"
        fi
    fi

    # Check if output exists and overwrite is not set
    if [ -f "$output_file" ] && [ "$OVERWRITE" = false ]; then
        print_warning "Skipping $input_file: output exists (use --overwrite)"
        return 1
    fi

    # Build the conversion command
    local cmd="$SCRIPT_DIR/dk-md2pdf"
    cmd="$cmd -f $OUTPUT_FORMAT"
    cmd="$cmd ${CONVERTER_ARGS[@]}"
    cmd="$cmd \"$input_file\" \"$output_file\""

    if [ "$DRY_RUN" = true ]; then
        print_info "Would convert: $input_file → $output_file"
        print_debug "Command: $cmd"
        return 0
    else
        print_debug "Converting: $input_file → $output_file"
        print_debug "Command: $cmd"

        # Execute conversion
        if [ "$QUIET" = true ]; then
            eval "$cmd" >/dev/null 2>&1
        else
            eval "$cmd" 2>&1 | sed 's/^/  /'
        fi

        return ${PIPESTATUS[0]}
    fi
}

# Process files in parallel
process_parallel() {
    local files=("$@")
    local pids=()
    local status_file=$(mktemp)

    # Process files with limited parallelism
    for file in "${files[@]}"; do
        # Wait if we've reached the job limit
        while [ ${#pids[@]} -ge $PARALLEL_JOBS ]; do
            for i in "${!pids[@]}"; do
                if ! kill -0 "${pids[$i]}" 2>/dev/null; then
                    wait "${pids[$i]}"
                    local exit_code=$?
                    [ $exit_code -ne 0 ] && echo "$file" >> "$status_file"
                    unset pids[$i]
                fi
            done
            pids=("${pids[@]}")  # Rebuild array
            sleep 0.1
        done

        # Start new conversion process
        (
            output_file=$(get_output_path "$file")
            convert_file "$file" "$output_file"
            exit $?
        ) &

        pids+=($!)

        # Update progress
        ((PROCESSED_FILES++))
        if [ "$SHOW_PROGRESS" = true ]; then
            local percent=$((PROCESSED_FILES * 100 / TOTAL_FILES))
            print_progress "[$PROCESSED_FILES/$TOTAL_FILES] ${percent}% - Processing: $(basename "$file")"
        fi
    done

    # Wait for remaining jobs
    for pid in "${pids[@]}"; do
        wait "$pid"
        local exit_code=$?
        [ $exit_code -ne 0 ] && ((FAILED_FILES++))
    done

    # Count failures
    if [ -f "$status_file" ]; then
        FAILED_FILES=$(wc -l < "$status_file")
        rm -f "$status_file"
    fi
}

# Process files sequentially
process_sequential() {
    local files=("$@")

    for file in "${files[@]}"; do
        output_file=$(get_output_path "$file")

        # Update progress
        ((PROCESSED_FILES++))
        if [ "$SHOW_PROGRESS" = true ]; then
            local percent=$((PROCESSED_FILES * 100 / TOTAL_FILES))
            print_progress "[$PROCESSED_FILES/$TOTAL_FILES] ${percent}% - Processing: $(basename "$file")"
        fi

        if ! convert_file "$file" "$output_file"; then
            ((FAILED_FILES++))
            FAILED_LIST+=("$file")
        fi
    done
}

# Main execution
main() {
    # Parse arguments
    INPUT_PATTERNS=()
    parse_args "$@"

    # Validate conflicting options
    if [ "$PRESERVE_STRUCTURE" = true ] && [ "$FLATTEN" = true ]; then
        print_error "Cannot use both --preserve-structure and --flatten"
        exit 1
    fi

    # Find all markdown files
    print_info "Searching for markdown files..."
    # Use a more portable approach instead of readarray
    FILES=()
    while IFS= read -r file; do
        FILES+=("$file")
    done < <(find_markdown_files "${INPUT_PATTERNS[@]}")

    if [ ${#FILES[@]} -eq 0 ]; then
        print_warning "No markdown files found matching the specified patterns"
        exit 0
    fi

    TOTAL_FILES=${#FILES[@]}
    print_info "Found $TOTAL_FILES markdown file(s) to process"

    # Show files in dry-run mode
    if [ "$DRY_RUN" = true ] || [ "$VERBOSE" = true ]; then
        echo "Files to process:"
        for file in "${FILES[@]}"; do
            output_file=$(get_output_path "$file")
            echo "  $file → $output_file"
        done
        echo ""
    fi

    # Create output directory if specified
    if [ -n "$OUTPUT_DIR" ] && [ "$DRY_RUN" = false ]; then
        mkdir -p "$OUTPUT_DIR"
        print_info "Output directory: $OUTPUT_DIR"
    fi

    # Process files
    if [ "$DRY_RUN" = false ]; then
        print_info "Starting conversion (format: $OUTPUT_FORMAT, jobs: $PARALLEL_JOBS)"

        if [ $PARALLEL_JOBS -gt 1 ]; then
            process_parallel "${FILES[@]}"
        else
            process_sequential "${FILES[@]}"
        fi
    else
        print_info "Dry run complete - no files were converted"
        PROCESSED_FILES=$TOTAL_FILES
    fi

    # Print summary
    echo ""
    print_info "=== Conversion Summary ==="
    print_info "Total files: $TOTAL_FILES"

    if [ "$DRY_RUN" = false ]; then
        local successful=$((PROCESSED_FILES - FAILED_FILES))
        print_info "Successful: $successful"

        if [ $FAILED_FILES -gt 0 ]; then
            print_warning "Failed: $FAILED_FILES"
            if [ ${#FAILED_LIST[@]} -gt 0 ] && [ "$VERBOSE" = true ]; then
                echo "Failed files:"
                for file in "${FAILED_LIST[@]}"; do
                    echo "  - $file"
                done
            fi
        fi
    fi

    # Set exit code based on results
    if [ $FAILED_FILES -eq 0 ]; then
        exit 0
    elif [ $FAILED_FILES -eq $TOTAL_FILES ]; then
        exit 2
    else
        exit 1
    fi
}

# Run main function
main "$@"