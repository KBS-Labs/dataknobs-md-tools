import re
from pathlib import Path

svg_files = sorted(Path('.').glob('processed-*.svg'))

for svg_file in svg_files:
    with open(svg_file, 'r', encoding='utf-8') as f:
        content = f.read()

    # Remove problematic attributes that cause "diagram" footer
    content = re.sub(r'\s*aria-roledescription="[^"]*"', '', content)
    content = re.sub(r'\s*role="graphics-document document"', '', content)

    # Remove inline width/max-width styles to allow proper sizing
    content = re.sub(r'\s*width="100%"', '', content)
    content = re.sub(r'style="([^"]*?)max-width:\s*[^;"]+(;?)([^"]*)"', r'style="\1\3"', content)

    # Add responsive sizing by merging with existing style or creating new one
    if 'max-width: 100%' not in content:
        # If there's already a style attribute, add to it
        if re.search(r'<svg[^>]*\sstyle="', content):
            content = re.sub(r'(<svg[^>]*\sstyle=")([^"]*)"', r'\1\2 max-width: 100%; height: auto;"', content, count=1)
        else:
            # Otherwise create new style attribute
            content = re.sub(r'(<svg[^>]*?)>', r'\1 style="max-width: 100%; height: auto;">', content, count=1)

    # Write cleaned version
    with open(svg_file, 'w', encoding='utf-8') as f:
        f.write(content)
