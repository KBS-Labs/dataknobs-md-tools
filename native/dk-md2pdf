    # Note: output.html already has embedded SVGs at this point (from Python script above)
    if [ "$KEEP_HTML" = true ]; then
        HTML_FILE="${OUTPUT_ABS%.pdf}.html"

        # Save the HTML file (already has embedded SVGs for PDF generation)
        cp "output.html" "$HTML_FILE"

        # If --keep-svgs is set, also clean and copy the SVG files to output directory
        if [ "$KEEP_SVGS" = true ]; then
            OUTPUT_DIR=$(dirname "$HTML_FILE")
            if ls processed-*.svg >/dev/null 2>&1; then
                # Clean up SVG files before copying
