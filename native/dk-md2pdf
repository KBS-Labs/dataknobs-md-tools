#!/bin/bash

# DataKnobs Markdown to PDF Converter
# Native implementation using pandoc, mermaid-cli, and weasyprint

set -e

# Get the project root directory
SCRIPT_PATH="${BASH_SOURCE[0]}"
# Resolve symlinks to get the actual script location
while [ -L "$SCRIPT_PATH" ]; do
    SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
    SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
    # Handle relative symlinks
    [[ "$SCRIPT_PATH" != /* ]] && SCRIPT_PATH="$SCRIPT_DIR/$SCRIPT_PATH"
done
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
# In Docker, PROJECT_ROOT is set by the entrypoint
if [ -z "$PROJECT_ROOT" ]; then
    PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
fi

# Auto-activate virtual environment if it exists (takes priority)
if [ -f "$PROJECT_ROOT/.venv/bin/activate" ]; then
    source "$PROJECT_ROOT/.venv/bin/activate"
else
    # Fall back to system Python paths
    # Setup PATH for Python packages
    if [[ "$OSTYPE" == "darwin"* ]]; then
        # Try current Python version first
        PYTHON_VERSION=$(python3 -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")' 2>/dev/null || echo "3.9")
        PYTHON_USER_BIN="$HOME/Library/Python/$PYTHON_VERSION/bin"
        if [ -d "$PYTHON_USER_BIN" ] && [[ ":$PATH:" != *":$PYTHON_USER_BIN:"* ]]; then
            export PATH="$PATH:$PYTHON_USER_BIN"
        fi

        # Also check common Python versions where weasyprint might be installed
        for py_ver in 3.9 3.10 3.11 3.12 3.13; do
            PYTHON_USER_BIN="$HOME/Library/Python/$py_ver/bin"
            if [ -d "$PYTHON_USER_BIN" ] && [[ ":$PATH:" != *":$PYTHON_USER_BIN:"* ]]; then
                export PATH="$PATH:$PYTHON_USER_BIN"
            fi
        done
    fi

    # Add .local/bin to PATH if it exists
    if [ -d "$HOME/.local/bin" ] && [[ ":$PATH:" != *":$HOME/.local/bin:"* ]]; then
        export PATH="$PATH:$HOME/.local/bin"
    fi
fi

# Detect if running in Docker container
IN_DOCKER=false
if [ -f "/.dockerenv" ]; then
    IN_DOCKER=true
fi

# Helper function to run Python with the project's dependencies
# In Docker, use the venv directly (uv is installed as root but we run as non-root user)
# Outside Docker, use uv run for proper environment management
run_python() {
    if [ "$IN_DOCKER" = true ]; then
        # In Docker, use the venv's Python directly
        # Check if the venv Python exists and is executable
        if [ -x "$PROJECT_ROOT/.venv/bin/python3" ]; then
            "$PROJECT_ROOT/.venv/bin/python3" "$@"
        else
            # Fall back to system Python in Docker if venv not accessible
            python3 "$@"
        fi
    elif command -v uv >/dev/null 2>&1; then
        # Outside Docker, use uv run
        (unset VIRTUAL_ENV; cd "$PROJECT_ROOT" && uv run python3 "$@")
    elif [ -f "$PROJECT_ROOT/.venv/bin/python3" ]; then
        # Fall back to venv if available
        "$PROJECT_ROOT/.venv/bin/python3" "$@"
    else
        # Last resort: system Python
        python3 "$@"
    fi
}

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Default values
OUTPUT_FORMAT="pdf"
THEME="github"
VERBOSE=false

# Function to print colored output
print_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

print_error() {
    echo -e "${RED}[ERROR]${NC} $1" >&2
}

print_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

# Check for required dependencies
check_dependencies() {
    local missing=()

    if ! command -v pandoc >/dev/null 2>&1; then
        missing+=("pandoc")
    fi

    if ! command -v mmdc >/dev/null 2>&1; then
        missing+=("mermaid-cli (mmdc)")
    fi

    # For PDF output, check for weasyprint
    if [ "$OUTPUT_FORMAT" = "pdf" ]; then
        if ! run_python -c "import weasyprint" 2>/dev/null; then
            if [ "$IN_DOCKER" = true ]; then
                missing+=("weasyprint (Docker image may be corrupted)")
            elif command -v uv >/dev/null 2>&1; then
                missing+=("weasyprint (run: uv sync)")
            else
                missing+=("weasyprint")
            fi
        fi
    fi

    if [ ${#missing[@]} -gt 0 ]; then
        print_error "Missing required dependencies: ${missing[*]}"
        echo ""
        echo "To install all dependencies automatically, run:"
        echo "  ./native/install.sh"
        echo ""
        echo "This will install uv, pandoc, Node.js, mermaid-cli, and Python dependencies."
        echo ""
        echo "Or install manually:"
        echo "  uv:          curl -LsSf https://astral.sh/uv/install.sh | sh"
        echo "  pandoc:      https://pandoc.org/installing.html"
        echo "  mermaid-cli: npm install -g @mermaid-js/mermaid-cli"
        echo "  Python deps: uv sync (from project root)"
        exit 1
    fi
}

# Display usage information
usage() {
    cat << EOF
Usage: $(basename "$0") [OPTIONS] input.md [output]

Convert Markdown files with Mermaid diagrams to PDF or HTML.
Output format is auto-detected from file extension (.html/.htm for HTML, .pdf for PDF).

OPTIONS:
    -h, --help          Show this help message
    -f, --format        Force output format: pdf or html (overrides extension)
    -t, --theme         CSS theme: github (default), academic, minimal, business
    -v, --verbose       Enable verbose output
    --no-mermaid        Skip Mermaid diagram processing
    --toc               Include table of contents
    --standalone        Create standalone HTML (embeds CSS)
    --keep-html         When generating PDF, also save the intermediate HTML
    --keep-svgs         Keep SVG files as external files (default: embed in HTML)
    --show-filename     Include filename as heading in output (default: omit)
    --overwrite         Force overwrite of existing output file
    --list-fonts        List available fonts and exit
    --font-body FONT    Font for body text (e.g., "Georgia", "Arial")
    --font-code FONT    Font for code blocks (e.g., "Monaco", "Courier")
    --font-size SIZE    Base font size in pixels (default: 16)
    --font-size-print SIZE  Print font size in points (default: 12pt)

EXAMPLES:
    $(basename "$0") input.md                    # Creates input.pdf
    $(basename "$0") input.md output.html        # Creates HTML with embedded SVGs
    $(basename "$0") input.md output.pdf         # Creates PDF (auto-detected)
    $(basename "$0") --keep-html input.md        # Creates both .pdf and .html
    $(basename "$0") --keep-svgs input.md out.html # HTML with external SVG files
    $(basename "$0") -f html input.md output     # Force HTML despite no extension
    $(basename "$0") -t academic --toc input.md  # Academic style with TOC
    $(basename "$0") --list-fonts                # List all available fonts
    $(basename "$0") --font-body "Georgia" --font-code "Monaco" input.md # Custom fonts
    $(basename "$0") --font-size 14 input.md     # Larger font size

EOF
}

# Parse command line arguments
SKIP_MERMAID=false
INCLUDE_TOC=false
STANDALONE=false
KEEP_HTML=false
KEEP_SVGS=false
SHOW_FILENAME=false
FORMAT_OVERRIDE=""
OVERWRITE=false
FONT_BODY=""
FONT_CODE=""
FONT_SIZE=""
FONT_SIZE_PRINT=""
LIST_FONTS=false

while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            usage
            exit 0
            ;;
        -f|--format)
            FORMAT_OVERRIDE="$2"
            shift 2
            ;;
        -t|--theme)
            THEME="$2"
            shift 2
            ;;
        -v|--verbose)
            VERBOSE=true
            shift
            ;;
        --no-mermaid)
            SKIP_MERMAID=true
            shift
            ;;
        --toc)
            INCLUDE_TOC=true
            shift
            ;;
        --standalone)
            STANDALONE=true
            shift
            ;;
        --keep-html)
            KEEP_HTML=true
            shift
            ;;
        --keep-svgs)
            KEEP_SVGS=true
            shift
            ;;
        --show-filename)
            SHOW_FILENAME=true
            shift
            ;;
        --overwrite)
            OVERWRITE=true
            shift
            ;;
        --list-fonts)
            LIST_FONTS=true
            shift
            ;;
        --font-body)
            FONT_BODY="$2"
            shift 2
            ;;
        --font-code)
            FONT_CODE="$2"
            shift 2
            ;;
        --font-size)
            FONT_SIZE="$2"
            shift 2
            ;;
        --font-size-print)
            FONT_SIZE_PRINT="$2"
            shift 2
            ;;
        -*)
            print_error "Unknown option: $1"
            usage
            exit 1
            ;;
        *)
            if [ -z "$INPUT_FILE" ]; then
                INPUT_FILE="$1"
            elif [ -z "$OUTPUT_FILE" ]; then
                OUTPUT_FILE="$1"
            else
                print_error "Too many arguments"
                usage
                exit 1
            fi
            shift
            ;;
    esac
done

# Handle --list-fonts option (exit early)
if [ "$LIST_FONTS" = true ]; then
    run_python -m python.font_manager list
    exit $?
fi

# Validate fonts if specified
if [ -n "$FONT_BODY" ]; then
    if ! run_python -m python.font_manager validate "$FONT_BODY" 2>&1; then
        print_error "Invalid body font: $FONT_BODY"
        exit 1
    fi
fi

if [ -n "$FONT_CODE" ]; then
    if ! run_python -m python.font_manager validate "$FONT_CODE" 2>&1; then
        print_error "Invalid code font: $FONT_CODE"
        exit 1
    fi
fi

# Validate input
if [ -z "$INPUT_FILE" ]; then
    print_error "No input file specified"
    usage
    exit 1
fi

if [ ! -f "$INPUT_FILE" ]; then
    print_error "Input file not found: $INPUT_FILE"
    exit 1
fi

# Determine output format from file extension if provided
if [ -n "$OUTPUT_FILE" ]; then
    # Check file extension (case insensitive)
    OUTPUT_EXT="${OUTPUT_FILE##*.}"
    OUTPUT_EXT_LOWER=$(echo "$OUTPUT_EXT" | tr '[:upper:]' '[:lower:]')

    case "$OUTPUT_EXT_LOWER" in
        html|htm)
            OUTPUT_FORMAT="html"
            ;;
        pdf)
            OUTPUT_FORMAT="pdf"
            ;;
        *)
            # If no recognized extension, use format override or default to pdf
            if [ -n "$FORMAT_OVERRIDE" ]; then
                OUTPUT_FORMAT="$FORMAT_OVERRIDE"
            else
                OUTPUT_FORMAT="pdf"
            fi
            ;;
    esac
else
    # No output file specified, use format override or default
    if [ -n "$FORMAT_OVERRIDE" ]; then
        OUTPUT_FORMAT="$FORMAT_OVERRIDE"
    else
        OUTPUT_FORMAT="pdf"
    fi
    OUTPUT_FILE="${INPUT_FILE%.md}.${OUTPUT_FORMAT}"
fi

# Override with explicit format flag if provided
if [ -n "$FORMAT_OVERRIDE" ]; then
    OUTPUT_FORMAT="$FORMAT_OVERRIDE"
fi

# Check dependencies
check_dependencies

# Check if output file exists and overwrite protection
if [ -f "$OUTPUT_FILE" ] && [ "$OVERWRITE" = false ]; then
    print_error "Output file already exists: $OUTPUT_FILE"
    echo "Use --overwrite to force overwrite"
    exit 1
fi

# Get absolute paths
TEMP_DIR=$(mktemp -d)

# Cleanup on exit
trap "rm -rf $TEMP_DIR" EXIT

# Process the markdown file
print_info "Processing: $INPUT_FILE → $OUTPUT_FILE"

# Save original directory for later use
ORIG_DIR="$(pwd)"

# Step 1: Process Mermaid diagrams if present
if [ "$SKIP_MERMAID" = false ] && grep -q '```mermaid' "$INPUT_FILE"; then
    print_info "Processing Mermaid diagrams..."

    # Get absolute path of input file before changing directory
    if [[ "$INPUT_FILE" = /* ]]; then
        INPUT_ABS="$INPUT_FILE"
    else
        INPUT_ABS="$ORIG_DIR/$INPUT_FILE"
    fi

    # Change to temp directory so SVGs are generated in the right place
    cd "$TEMP_DIR"

    # If running in Docker, copy puppeteer config to temp directory
    if [ -f /.puppeteerrc.cjs ]; then
        cp /.puppeteerrc.cjs .puppeteerrc.cjs
    fi

    # Use mermaid-cli to process diagrams with proper configuration
    MERMAID_CONFIG=""
    PUPPETEER_CONFIG=""

    if [ -f "$PROJECT_ROOT/src/config/mermaid-config.json" ]; then
        MERMAID_CONFIG="-c $PROJECT_ROOT/src/config/mermaid-config.json"
    fi

    # Use puppeteer config for both Docker and native
    if [ -f "$PROJECT_ROOT/src/config/puppeteer-config.json" ]; then
        PUPPETEER_CONFIG="-p $PROJECT_ROOT/src/config/puppeteer-config.json"
    fi

    # Debug output
    if [ "$VERBOSE" = true ]; then
        echo "PROJECT_ROOT: $PROJECT_ROOT" >&2
        echo "MERMAID_CONFIG: $MERMAID_CONFIG" >&2
        echo "PUPPETEER_CONFIG: $PUPPETEER_CONFIG" >&2
    fi

    # Build mmdc command arguments
    MMDC_ARGS=(-i "$INPUT_ABS" -o "processed.md")
    [ -n "$MERMAID_CONFIG" ] && MMDC_ARGS+=($MERMAID_CONFIG)
    [ -n "$PUPPETEER_CONFIG" ] && MMDC_ARGS+=($PUPPETEER_CONFIG)

    # Run mermaid-cli (now in temp dir)
    if [ "$VERBOSE" = true ]; then
        echo "Running: mmdc ${MMDC_ARGS[*]}" >&2
        mmdc "${MMDC_ARGS[@]}" || {
            print_warning "Mermaid processing failed, continuing without diagrams"
            cp "$INPUT_ABS" "processed.md"
        }
    else
        MMDC_STDERR=$(mmdc "${MMDC_ARGS[@]}" 2>&1) || {
            print_warning "Mermaid processing failed, continuing without diagrams"
            if [ -n "$MMDC_STDERR" ]; then
                print_warning "mmdc output: $MMDC_STDERR"
            fi
            cp "$INPUT_ABS" "processed.md"
        }
    fi

    # Change back to original directory
    cd - >/dev/null
else
    cp "$INPUT_FILE" "$TEMP_DIR/processed.md"
fi

# Step 2: Set up pandoc options
PANDOC_OPTS=()
PANDOC_OPTS+=(--standalone)
PANDOC_OPTS+=(--from markdown+task_lists)

# Add TOC if requested
if [ "$INCLUDE_TOC" = true ]; then
    PANDOC_OPTS+=(--toc)
    PANDOC_OPTS+=(--toc-depth=3)
fi

# Add template and styling
TEMPLATE_PATH="$PROJECT_ROOT/src/templates/default.html"
if [ -f "$TEMPLATE_PATH" ]; then
    PANDOC_OPTS+=(--template="$TEMPLATE_PATH")
fi

CSS_PATH="$PROJECT_ROOT/src/templates/styles/${THEME}.css"
if [ -f "$CSS_PATH" ]; then
    if [ "$STANDALONE" = true ] || [ "$OUTPUT_FORMAT" = "pdf" ]; then
        # Embed CSS for standalone or PDF output
        PANDOC_OPTS+=(--css="$CSS_PATH")

        # Check Pandoc version and use appropriate flags
        PANDOC_VERSION=$(pandoc --version | head -n1 | cut -d' ' -f2 | cut -d'.' -f1)
        if [ "$PANDOC_VERSION" -ge 3 ] 2>/dev/null; then
            # Pandoc 3.x+: use modern flags
            PANDOC_OPTS+=(--embed-resources --standalone)
        else
            # Pandoc < 3.0: use legacy flag
            PANDOC_OPTS+=(--self-contained)
        fi
    else
        # Link to CSS for regular HTML
        PANDOC_OPTS+=(--css="$CSS_PATH")
    fi
fi

# Generate custom font CSS if font options are specified
if [ -n "$FONT_BODY" ] || [ -n "$FONT_CODE" ] || [ -n "$FONT_SIZE" ] || [ -n "$FONT_SIZE_PRINT" ]; then
    CUSTOM_CSS_PATH="$TEMP_DIR/custom-fonts.css"

    cat > "$CUSTOM_CSS_PATH" << EOF
/* Custom Font Overrides */

EOF

    # Override body font
    if [ -n "$FONT_BODY" ]; then
        cat >> "$CUSTOM_CSS_PATH" << EOF
body,
.markdown-body {
    font-family: "$FONT_BODY", -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif !important;
}

EOF
    fi

    # Override code font
    if [ -n "$FONT_CODE" ]; then
        cat >> "$CUSTOM_CSS_PATH" << EOF
code,
pre,
.markdown-body code,
.markdown-body pre code {
    font-family: "$FONT_CODE", SFMono-Regular, Consolas, "Liberation Mono", Menlo, monospace !important;
}

EOF
    fi

    # Override font size
    if [ -n "$FONT_SIZE" ]; then
        cat >> "$CUSTOM_CSS_PATH" << EOF
body,
.markdown-body {
    font-size: ${FONT_SIZE}px !important;
}

EOF
    fi

    # Override print font size
    if [ -n "$FONT_SIZE_PRINT" ]; then
        cat >> "$CUSTOM_CSS_PATH" << EOF
@media print {
    body,
    .markdown-body {
        font-size: ${FONT_SIZE_PRINT} !important;
    }
}

EOF
    fi

    # Add custom CSS to pandoc options
    PANDOC_OPTS+=(--css="$CUSTOM_CSS_PATH")

    if [ "$VERBOSE" = true ]; then
        print_info "Using custom fonts:"
        [ -n "$FONT_BODY" ] && echo "  Body: $FONT_BODY"
        [ -n "$FONT_CODE" ] && echo "  Code: $FONT_CODE"
        [ -n "$FONT_SIZE" ] && echo "  Size: ${FONT_SIZE}px"
        [ -n "$FONT_SIZE_PRINT" ] && echo "  Print: $FONT_SIZE_PRINT"
    fi
fi

# Add metadata - only include filename as title if requested
if [ "$SHOW_FILENAME" = true ]; then
    PANDOC_OPTS+=(--metadata title="$(basename "${INPUT_FILE%.md}")")
fi

# Step 3: Convert based on output format
if [ "$OUTPUT_FORMAT" = "html" ]; then
    print_info "Generating HTML..."

    # Get absolute path of output file
    if [[ "$OUTPUT_FILE" = /* ]]; then
        OUTPUT_ABS="$OUTPUT_FILE"
    else
        OUTPUT_ABS="$ORIG_DIR/$OUTPUT_FILE"
    fi

    # Run pandoc from temp directory so it can find the SVGs
    cd "$TEMP_DIR"

    # First convert to HTML
    # Use KaTeX for math rendering in HTML (includes from CDN)
    pandoc "processed.md" \
           "${PANDOC_OPTS[@]}" \
           --katex \
           --resource-path=".:$TEMP_DIR" \
           -o "$OUTPUT_ABS"

    if [ "$KEEP_SVGS" = false ]; then
        # Inline SVGs directly as XML for self-contained HTML
        if ls processed-*.svg >/dev/null 2>&1; then
            print_info "Inlining SVG images in HTML..."

            # Use Python to inline SVGs directly as XML
            python3 << PYTHON_SCRIPT
import re
import sys
from pathlib import Path

# Read the HTML file
with open('$OUTPUT_ABS', 'r', encoding='utf-8') as f:
    html_content = f.read()

# Find all SVG files
svg_files = sorted(Path('.').glob('processed-*.svg'))

# Replace each SVG img reference with inline SVG content
for svg_file in svg_files:
    svg_filename = svg_file.name
    # Read the SVG content
    with open(svg_file, 'r', encoding='utf-8') as f:
        svg_content = f.read()

    # Remove XML declaration if present
    svg_content = re.sub(r'<\?xml[^?]*\?>\s*', '', svg_content)

    # Remove attributes that cause issues
    svg_content = re.sub(r'\s*aria-roledescription="[^"]*"', '', svg_content)
    svg_content = re.sub(r'\s*role="graphics-document document"', '', svg_content)

    # Remove inline width/max-width styles to allow CSS control
    svg_content = re.sub(r'style="([^"]*?)max-width:\s*[^;"]+(;?)([^"]*)"', r'style="\1\3"', svg_content)
    svg_content = re.sub(r'\s*width="100%"', '', svg_content)

    # Add responsive sizing
    svg_content = re.sub(r'<svg', '<svg style="max-width: 100%; height: auto;"', svg_content, count=1)

    # Wrap SVG in a container div for better sizing control
    svg_wrapped = f'<div class="svg-container" style="width: 100%; max-width: 100%; overflow-x: auto;">{svg_content}</div>'

    # Find and replace img tags that reference this SVG
    img_pattern = r'<img\s+src="\./' + re.escape(svg_filename) + r'"[^>]*/?>'

    # Replace with inline SVG
    html_content = re.sub(img_pattern, svg_wrapped, html_content)

# Write back
with open('$OUTPUT_ABS', 'w', encoding='utf-8') as f:
    f.write(html_content)

PYTHON_SCRIPT
        fi
    else
        # Keep SVGs as external files - clean and copy them to output directory
        OUTPUT_DIR=$(dirname "$OUTPUT_ABS")
        if ls processed-*.svg >/dev/null 2>&1; then
            # Clean up SVG files before copying
            python3 << 'PYTHON_SCRIPT'
import re
from pathlib import Path

svg_files = sorted(Path('.').glob('processed-*.svg'))

for svg_file in svg_files:
    with open(svg_file, 'r', encoding='utf-8') as f:
        content = f.read()

    # Remove problematic attributes that cause "diagram" footer
    content = re.sub(r'\s*aria-roledescription="[^"]*"', '', content)
    content = re.sub(r'\s*role="graphics-document document"', '', content)

    # Remove inline width/max-width styles to allow proper sizing
    content = re.sub(r'\s*width="100%"', '', content)
    content = re.sub(r'style="([^"]*?)max-width:\s*[^;"]+(;?)([^"]*)"', r'style="\1\3"', content)

    # Add responsive sizing by merging with existing style or creating new one
    if 'max-width: 100%' not in content:
        # If there's already a style attribute, add to it
        if re.search(r'<svg[^>]*\sstyle="', content):
            content = re.sub(r'(<svg[^>]*\sstyle=")([^"]*)"', r'\1\2 max-width: 100%; height: auto;"', content, count=1)
        else:
            # Otherwise create new style attribute
            content = re.sub(r'(<svg[^>]*?)>', r'\1 style="max-width: 100%; height: auto;">', content, count=1)

    # Write cleaned version
    with open(svg_file, 'w', encoding='utf-8') as f:
        f.write(content)
PYTHON_SCRIPT

            cp processed-*.svg "$OUTPUT_DIR/"
            print_info "SVG files copied to output directory"
        fi
    fi

    cd - >/dev/null

elif [ "$OUTPUT_FORMAT" = "pdf" ]; then
    print_info "Generating PDF..."

    # Get absolute path of output file
    if [[ "$OUTPUT_FILE" = /* ]]; then
        OUTPUT_ABS="$OUTPUT_FILE"
    else
        OUTPUT_ABS="$ORIG_DIR/$OUTPUT_FILE"
    fi

    # Run pandoc from temp directory so it can find the SVGs
    cd "$TEMP_DIR"

    # First convert to HTML with SVG references
    # Use webtex for math rendering in PDF (converts to images)
    pandoc "processed.md" \
           "${PANDOC_OPTS[@]}" \
           --webtex \
           --resource-path=".:$TEMP_DIR" \
           -o "output.html"

    # For PDF generation, we need to process SVGs in the HTML
    # (either from files or base64-encoded) so weasyprint can render them correctly
    print_info "Processing SVGs in HTML for PDF generation..."

    # Get absolute path to output.html in current (temp) directory
    HTML_PATH="$(pwd)/output.html"

    # Use our Python CLI module to process the HTML file
    # This handles both file-based SVGs and base64-encoded SVGs
    run_python -m python.process_html "$HTML_PATH"

    # If --keep-html is set, save the HTML file
    # Note: output.html already has embedded SVGs at this point (from Python script above)
    if [ "$KEEP_HTML" = true ]; then
        HTML_FILE="${OUTPUT_ABS%.pdf}.html"

        # Save the HTML file (already has embedded SVGs for PDF generation)
        cp "output.html" "$HTML_FILE"

        # If --keep-svgs is set, also clean and copy the SVG files to output directory
        if [ "$KEEP_SVGS" = true ]; then
            OUTPUT_DIR=$(dirname "$HTML_FILE")
            if ls processed-*.svg >/dev/null 2>&1; then
                # Clean up SVG files before copying
                python3 << 'PYTHON_SCRIPT'
import re
from pathlib import Path

svg_files = sorted(Path('.').glob('processed-*.svg'))

for svg_file in svg_files:
    with open(svg_file, 'r', encoding='utf-8') as f:
        content = f.read()

    # Remove problematic attributes that cause "diagram" footer
    content = re.sub(r'\s*aria-roledescription="[^"]*"', '', content)
    content = re.sub(r'\s*role="graphics-document document"', '', content)

    # Remove inline width/max-width styles to allow proper sizing
    content = re.sub(r'\s*width="100%"', '', content)
    content = re.sub(r'style="([^"]*?)max-width:\s*[^;"]+(;?)([^"]*)"', r'style="\1\3"', content)

    # Add responsive sizing by merging with existing style or creating new one
    if 'max-width: 100%' not in content:
        # If there's already a style attribute, add to it
        if re.search(r'<svg[^>]*\sstyle="', content):
            content = re.sub(r'(<svg[^>]*\sstyle=")([^"]*)"', r'\1\2 max-width: 100%; height: auto;"', content, count=1)
        else:
            # Otherwise create new style attribute
            content = re.sub(r'(<svg[^>]*?)>', r'\1 style="max-width: 100%; height: auto;">', content, count=1)

    # Write cleaned version
    with open(svg_file, 'w', encoding='utf-8') as f:
