    f.write(html_content)

PYTHON_SCRIPT
        fi
    else
        # Keep SVGs as external files - clean and copy them to output directory
        OUTPUT_DIR=$(dirname "$OUTPUT_ABS")
        if ls processed-*.svg >/dev/null 2>&1; then
            # Clean up SVG files before copying
            python3 << 'PYTHON_SCRIPT'
